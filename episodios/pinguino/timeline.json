    "dur": 4.258
   }
  ],
  "end": 32.954
 },
 {
  "id": "mama",
  "ch": 1,
  "start": 32.954,
  "lines": [
   {
    "txt": "Apenas lo pone, te pasa a tu papá con muchísimo cuidado, y se va caminando hacia el mar.",
