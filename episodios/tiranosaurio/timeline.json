    "dur": 1.59
   }
  ],
  "end": 463.74800000000033
 },
 {
  "id": "adios",
  "ch": 8,
  "start": 463.74800000000033,
  "lines": [
   {
    "txt": "En la vitrina de al lado está Rufino, con una etiqueta que dice: roca.",
    "file": "voz/adios_0.wav",
    "start": 464.24800000000033,
    "dur": 4.214
   },
   {
    "txt": "Nunca dijo nada. Se lo agradeces.",
